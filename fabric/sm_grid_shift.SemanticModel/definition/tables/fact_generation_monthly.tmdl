table fact_generation_monthly
	lineageTag: e3b183fd-2d37-482d-9a2c-d386a8d791d4
	sourceLineageTag: [mart].[fact_generation_monthly]

	/// Monthly electricity generation in TWh for the sources in the current filter context. Aggregated sources must not be summed with individual fuels.
	measure 'Monthly Generation TWh' = SUM(fact_generation_monthly[generation_twh])
		formatString: #,0.0
		displayFolder: Generation
		lineageTag: 8f8f410f-0fbd-4556-bfbc-46f5d7a1d25d

	/// Monthly total electricity generation in TWh (the Ember "Total generation" source).
	measure 'Monthly Total Generation TWh' = CALCULATE([Monthly Generation TWh], REMOVEFILTERS(dim_source), dim_source[source_name] = "Total generation")
		formatString: #,0.0
		displayFolder: Generation
		lineageTag: 340188af-2254-4227-9c8f-b213d8bd0d44

	/// Monthly gas generation as a share of total generation.
	measure 'Monthly Gas Share %' = DIVIDE(CALCULATE([Monthly Generation TWh], dim_source[source_name] = "Gas"), [Monthly Total Generation TWh])
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: 4921bac7-ed4b-4501-855e-9b291a31afd5

	/// Monthly coal generation as a share of total generation.
	measure 'Monthly Coal Share %' = DIVIDE(CALCULATE([Monthly Generation TWh], dim_source[source_name] = "Coal"), [Monthly Total Generation TWh])
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: 791b015f-93b9-44bc-9f16-ad3c8bdac033

	/// Monthly clean generation (Ember aggregate "Clean") as a share of total generation.
	measure 'Monthly Clean Share %' = DIVIDE(CALCULATE([Monthly Generation TWh], dim_source[source_name] = "Clean"), [Monthly Total Generation TWh])
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: 46e20f83-6f5d-44df-9ec5-19427090a606

	/// Monthly generation-weighted carbon intensity in gCO2e per kWh: emissions divided by total generation.
	measure 'Monthly Carbon Intensity' = DIVIDE(CALCULATE(SUM(fact_generation_monthly[emissions_mtco2e]), REMOVEFILTERS(dim_source), dim_source[source_name] = "Total generation") * 1000, [Monthly Total Generation TWh])
		formatString: #,0
		displayFolder: Carbon
		lineageTag: ef2211aa-c85d-47af-b6ff-67a5c4e540f4

