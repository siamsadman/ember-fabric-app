// Generation mix by individual fuel in the area's latest year with generation data.
DEFINE
    VAR _AreaName = "Bangladesh"
    VAR _Area = TREATAS({ _AreaName }, dim_area[area_name])
    VAR _LatestYear =
        CALCULATE(
            MAXX(FILTER(VALUES(dim_year[year]), NOT ISBLANK([Total Generation TWh])), dim_year[year]),
            _Area
        )
    VAR _Fuels =
        FILTER(
            ALL(dim_source[source_name], dim_source[is_aggregated], dim_source[source_group]),
            NOT dim_source[is_aggregated] && dim_source[source_group] <> "Imports"
        )

EVALUATE
SUMMARIZECOLUMNS(
    dim_year[year],
    dim_source[source_name],
    dim_source[sort_order],
    dim_source[color_hex],
    _Area,
    TREATAS({ _LatestYear }, dim_year[year]),
    _Fuels,
    "Share", [Source Share %],
    "Generation TWh", [Generation TWh]
)
ORDER BY dim_source[sort_order]
