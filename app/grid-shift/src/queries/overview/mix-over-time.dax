// Share of generation by individual fuel, 2000 onward. Aggregates and net imports are excluded
// so the stack sums to total generation.
DEFINE
    VAR _AreaName = "Bangladesh"
    VAR _Fuels =
        FILTER(
            ALL(dim_source[source_name], dim_source[is_aggregated], dim_source[source_group]),
            NOT dim_source[is_aggregated] && dim_source[source_group] <> "Imports"
        )

EVALUATE
SUMMARIZECOLUMNS(
    dim_year[year],
    dim_source[source_name],
    dim_source[sort_order],
    dim_source[color_hex],
    TREATAS({ _AreaName }, dim_area[area_name]),
    FILTER(ALL(dim_year[year]), dim_year[year] >= 2000),
    _Fuels,
    "Share", [Source Share %]
)
ORDER BY dim_year[year], dim_source[sort_order]
