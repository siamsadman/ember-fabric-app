// Headline KPIs for one area in its latest year with generation data.
DEFINE
    VAR _AreaName = "Bangladesh"
    VAR _Area = TREATAS({ _AreaName }, dim_area[area_name])
    VAR _LatestYear =
        CALCULATE(
            MAXX(FILTER(VALUES(dim_year[year]), NOT ISBLANK([Total Generation TWh])), dim_year[year]),
            _Area
        )

EVALUATE
SUMMARIZECOLUMNS(
    dim_year[year],
    _Area,
    TREATAS({ _LatestYear }, dim_year[year]),
    "Carbon Intensity", [Carbon Intensity gCO2 per kWh],
    "Gas Share", [Gas Share %],
    "Gas Share YoY pts", [Gas Share YoY pts],
    "Import Share", [Import Share %],
    "Demand TWh", [Demand TWh],
    "Clean Share", [Clean Share %]
)
